PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# SQLite file (created automatically)
SQLITE_PATH=./data/vega.db

# Optional: email notifications for booking/contact forms (SMTP)
# Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=yourclinicemail@gmail.com
# SMTP_PASS=your_gmail_app_password
SMTP_HOST=your_smtp_host
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_username_or_email
SMTP_PASS=your_smtp_password_or_app_password
CONTACT_EMAIL_TO=info@vegaphysio.com
CONTACT_EMAIL_FROM=your_smtp_username_or_email
